{
    "name": "saizul/woo-bd-shipping",
    "description": "Bangladesh districts, zone based shipping, COD fee and checkout tweaks for WooCommerce.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "homepage": "https://saizul.com",
    "authors": [
        { "name": "Saizul Amin", "homepage": "https://saizul.com" }
    ],
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": { "WooBDShipping\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "WooBDShipping\\Tests\\": "tests/" }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "find . -name '*.php' -not -path './vendor/*' -print0 | xargs -0 -n1 php -l"
    },
    "config": {
        "sort-packages": true
    }
}
